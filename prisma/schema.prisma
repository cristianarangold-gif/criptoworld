generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/coinlens/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ─── News ───────────────────────────────────────────────

model NewsCategory {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nameEn    String   @map("name_en")
  nameEs    String   @map("name_es")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  articles NewsArticle[]

  @@map("news_categories")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model NewsArticle {
  id                  Int           @id @default(autoincrement())
  slug                String        @unique
  title               String
  excerpt             String?
  content             String?
  image               String?
  sourceName          String?       @map("source_name")
  sourceUrl           String?       @map("source_url")
  originalUrl         String?       @unique @map("original_url")
  originalPublishedAt DateTime?     @map("original_published_at")
  author              String?
  categoryId          Int?          @map("category_id")
  category            NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status              ArticleStatus @default(DRAFT)
  featured            Boolean       @default(false)
  readTimeMinutes     Int?          @map("read_time_minutes")
  isEditorial         Boolean       @default(false) @map("is_editorial")
  locale              String        @default("en")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId])
  @@index([slug])
  @@index([featured])
  @@map("news_articles")
}

// ─── Crypto Catalogue / Snapshot Cache ──────────────────

model Cryptocurrency {
  id                 Int      @id @default(autoincrement())
  coinGeckoId        String   @unique @map("coingecko_id")
  symbol             String
  name               String
  slug               String   @unique
  image              String?
  currentPrice       Float?   @map("current_price")
  marketCap          Float?   @map("market_cap")
  marketCapRank      Int?     @map("market_cap_rank")
  totalVolume        Float?   @map("total_volume")
  priceChange24h     Float?   @map("price_change_24h")
  priceChangePct24h  Float?   @map("price_change_pct_24h")
  priceChangePct1h   Float?   @map("price_change_pct_1h")
  priceChangePct7d   Float?   @map("price_change_pct_7d")
  circulatingSupply  Float?   @map("circulating_supply")
  maxSupply          Float?   @map("max_supply")
  ath                Float?
  atl                Float?
  sparkline7d        String?  @map("sparkline_7d")
  lastUpdated        DateTime @default(now()) @map("last_updated")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([symbol])
  @@index([marketCapRank])
  @@map("cryptocurrencies")
}

// ─── Newsletter ─────────────────────────────────────────

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  locale    String   @default("en")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

